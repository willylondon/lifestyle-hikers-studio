# --- Core ---
# Secret used to sign session cookies (generate: `openssl rand -base64 32`)
SESSION_SECRET=change-me

# Base URL of the app (used for OAuth redirects and absolute URLs)
APP_URL=http://localhost:3000

# Protects the daily Vercel media-retention job.
CRON_SECRET=change-me

# --- Database & storage ---
# Filesystem locations (relative to project root)
DATA_DIR=./data
MEDIA_DIR=./data/media

# --- Supabase (optional production backend) ---
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, the app uses
# Supabase Postgres + Storage instead of SQLite + local files. The key may
# be a modern sb_secret_ key (recommended) or a legacy service_role JWT.
# Keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lifestyle-hikers-media

# --- AI provider (OpenAI-compatible). Optional — app has a deterministic fallback. ---
# Set to "openai" to use a real LLM. Leave empty to use the built-in heuristic engine.
AI_PROVIDER=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Image enhancement ---
# "sharp" (deterministic, local) or "ai" (external model). Default sharp.
ENHANCEMENT_ENGINE=sharp
# Minimum QA confidence (0-1) before enhancement is auto-reverted
QA_CONFIDENCE_THRESHOLD=0.90

# --- Google Drive (optional read-only import) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Instagram (Meta) ---
# Meta Graph API app credentials — server-side only. Never prefix with NEXT_PUBLIC_.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
META_GRAPH_VERSION=v26.0
# This app is intentionally locked to @LifestyleHikers.
META_INSTAGRAM_USERNAME=lifestylehikers
# Strongly recommended: the numeric Professional Account ID returned by GET /me.
# When set, both the username and immutable numeric ID must match.
META_INSTAGRAM_ACCOUNT_ID=
